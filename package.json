{
  "name": "kijkdoos",
  "version": "1.0.0",
  "description": "Kijkdoos IPTV — gratis films, series en live tv + eigen abonnementen (Android, Windows, web)",
  "author": "Endless1977",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "python3 proxy.py",
    "build:win": "electron-builder --win --publish never",
    "android:add": "cap add android",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "nl.endless.kijkdoos",
    "productName": "Kijkdoos",
    "files": ["www/**", "electron/**", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Kijkdoos-Setup-${version}.exe" },
    "portable": { "artifactName": "Kijkdoos-Portable-${version}.exe" }
  }
}
